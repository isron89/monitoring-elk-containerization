        <mxCell id="5opepJyo4EoPyGQt87lH-71" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;Latar belakang:&lt;div&gt;- Terdapat variasi monitoring tools pada setiap aplikasi di Pertamina Patra Niaga&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Setiap aplikasi dominan memiliki dashboard monitoring yang berbeda&lt;/div&gt;&lt;div&gt;- Kustomisasi penggunaan log bergantung pada fitur dan cost masing masing provider monitoring&lt;/div&gt;&lt;div&gt;- Penggunaan dashboard monitoring rata-rata terfokus pada environment production&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="530" x="-2490" y="120" as="geometry" />
        </mxCell>
        <mxCell id="5opepJyo4EoPyGQt87lH-72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;Usulan pengembangan:&lt;div&gt;- Monitoring log terpusat pada satu dashboard monitoring&lt;/div&gt;&lt;div&gt;- Utilisasi log dapat digunakan untuk data analytic&lt;/div&gt;&lt;div&gt;- Kustomisasi policy atau informasi log dapat dilakukan sesuai kebutuhan dan cost less&lt;/div&gt;&lt;div&gt;- Setup monitoring aplikasi dalam satu platform dan konfigurasi&lt;/div&gt;&lt;div&gt;- Memudahkan tracing dalam setiap enviroment apabila terdapat integrasi atau proses yang strict&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="530" x="-2490" y="280" as="geometry" />
